# Build the current application first. This image and its temporary containers
# are independent of the running local app and its workspace volume.
ARG APP_IMAGE=naseweis-regression-app:local
# TEMPORARY: until openms-insight 0.7.10 is on PyPI (requirements.txt pins it then),
# the gate runs it from its development branch (t0mdavid-m/OpenMS-Insight#151),
# the same commit as scripts/desktop_insight_dev.sh. Remove this stage with it.
FROM node:20-bookworm AS insight
ARG INSIGHT_COMMIT=7e403fe75343e3b09d37bad4d56e7bc9b222c059
RUN git clone --quiet https://github.com/t0mdavid-m/OpenMS-Insight /insight \
    && git -C /insight checkout --quiet "$INSIGHT_COMMIT" \
    && cd /insight/js-component && npm ci --no-audit --no-fund && npm run build \
    && mkdir -p /insight/openms_insight/js-component \
    && cp -R /insight/js-component/dist /insight/openms_insight/js-component/ \
    && rm -rf /insight/js-component/node_modules

FROM ${APP_IMAGE}
WORKDIR /app
# The framework's dependency-license tests build a small git repository.
RUN apt-get update && apt-get install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/*
# Each test points the app at its own workspaces folder; the app image's
# shared folder would carry one test's saved settings into the next.
ENV LOCAL_WORKSPACES_DIR=
COPY requirements-dev.txt /app/requirements-dev.txt
RUN /root/miniforge3/envs/streamlit-env/bin/python -m pip install --no-cache-dir -r requirements-dev.txt
COPY --from=insight /insight /tmp/openms-insight
RUN /root/miniforge3/envs/streamlit-env/bin/python -m pip install --no-cache-dir --no-deps --force-reinstall /tmp/openms-insight \
    && rm -rf /tmp/openms-insight \
    && /root/miniforge3/envs/streamlit-env/bin/python -c "from openms_insight import SequenceCoverage"
# Framework tests also inspect the Dockerfiles and Kubernetes manifests.
# Include the full current checkout; .dockerignore excludes local data/secrets.
COPY . /app/
