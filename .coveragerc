[run]
branch = True
source = .
omit =
    .venv/*
    .local/*
    .claude/*
    tests/*
    test.py
    test_gui.py

[report]
# Keep this list aligned with the app-owned application code. Framework
# coverage is separate; adding thousands of template lines hides app gaps.
include =
    app.py
    content/quickstart.py
    content/naseweis.py
    content/topp_workflow_file_upload.py
    content/topp_workflow_execution.py
    content/topp_workflow_results.py
    content/decoy_database.py
    content/naseweis_raw_viewer.py
    src/Workflow.py
    src/DecoyWorkflow.py
    src/naseweis_tools.py
    src/naseweis_validation.py
    src/naseweis_results.py
    src/naseweis_lfq.py
    src/naseweis_experiment.py
    src/naseweis_experiment_ui.py
    src/naseweis_comparison.py
    src/naseweis_comparison_plots.py
    src/naseweis_coverage.py
    src/naseweis_result_plots_ui.py
    src/naseweis_viewers.py
    src/naseweis_msdata.py
    src/naseweis_annotations.py
    src/naseweis_plots.py
    src/naseweis_provenance.py
    src/workflow/host_paths.py
    src/workflow/process_state.py
    src/workflow/file_lock.py
    src/plot_full_coverage.py
fail_under = 95
precision = 2
show_missing = True
